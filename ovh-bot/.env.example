# Copy this file to .env and fill in your real values.
# Never commit .env to Git.

OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=your_ovh_application_key
OVH_APPLICATION_SECRET=your_ovh_application_secret
OVH_CONSUMER_KEY=your_ovh_consumer_key
OVH_ZONE=IE

TG_BOT_TOKEN=your_telegram_bot_token
TG_ALLOWED_USERS=your_telegram_user_id
# Keep false unless this bot is intentionally public. Empty allowlist + false refuses startup.
TG_ALLOW_ALL_USERS=false
TG_CHAT_ID=your_telegram_chat_id

# Standalone monitor.py defaults to notification-only mode.
MONITOR_AUTO_BUY=false
MONITOR_MAX_ORDERS=1
MONITOR_INTERVAL=10
MONITOR_ORDER_COOLDOWN=120
MONITOR_DATACENTER=
